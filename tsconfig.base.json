{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": false,
    "allowSyntheticDefaultImports": true,
    "strictPropertyInitialization": true,
    "experimentalDecorators": true,
    "emitDeclarationOnly": false,
    "strictNullChecks": true,
    "isolatedModules": true,
    "sourceMap": false,
    "inlineSourceMap": false,
    "allowJs": true,
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "importHelpers": true,
    "moduleResolution": "Bundler",
    "module": "ES2022",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@pluto/helm/badge": ["./libs/ui-helm/src/badge/src/index.ts"],
      "@pluto/helm/button": ["./libs/ui-helm/src/button/src/index.ts"],
      "@pluto/helm/card": ["./libs/ui-helm/src/card/src/index.ts"],
      "@pluto/helm/skeleton": ["./libs/ui-helm/src/skeleton/src/index.ts"],
      "@pluto/helm/utils": ["./libs/ui-helm/src/utils/src/index.ts"]
    },
    "rootDir": "."
  },
  "angularCompilerOptions": {
    "disableTypeScriptVersionCheck": true,
    "enableResourceInlining": false,
    "enableI18nLegacyMessageIdFormat": false,
    "fullTemplateTypeCheck": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true,
    "extendedDiagnostics": {
      "defaultCategory": "error"
    }
  }
}
