{
  "languages": {
    "TypeScript": {
      "language_servers": ["angular", "vtsls", "oxc", "!typescript-language-server", "..."],
      "formatter": { "language_server": { "name": "oxc" } },
      "code_actions_on_format": { "source.fixAll.oxc": true }
    },
    "HTML": {
      "language_servers": ["angular", "oxc", "..."],
      "formatter": { "language_server": { "name": "oxc" } }
    },
    "CSS": {
      "formatter": { "language_server": { "name": "oxc" } }
    }
  }
}
