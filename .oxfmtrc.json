{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": true,
  "printWidth": 94,
  "singleQuote": true,
  "semi": false,
  "ignorePatterns": ["**/*generated*", "pnpm-lock.yaml"],
  "overrides": [
    { "files": ["**/*.html"], "options": { "singleQuote": false } },
    { "files": ["**/*.{json,yml,yaml,md}"], "options": { "useTabs": false } }
  ],
  "sortImports": {
    "newlinesBetween": true,
    "customGroups": [
      { "groupName": "pluto", "elementNamePattern": ["@pluto/**"] },
      { "groupName": "pluto-feature", "elementNamePattern": ["@pluto-feature/**"] }
    ],
    "groups": [
      ["builtin", "external"],
      "pluto",
      "pluto-feature",
      ["parent", "sibling", "index"],
      "unknown"
    ]
  }
}
