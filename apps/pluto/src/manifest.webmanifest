{
	"$schema": "https://json.schemastore.org/web-manifest",
	"name": "Pluto",
	"short_name": "Pluto",
	"theme_color": "#0641e6",
	"background_color": "#f9f9fa",
	"display": "standalone",
	"scope": "./",
	"start_url": "/?source=pwa",
	"icons": [
		{
			"src": "/assets/pwa/pwa-64x64.png",
			"sizes": "64x64",
			"type": "image/png"
		},
		{
			"src": "/assets/pwa/pwa-192x192.png",
			"sizes": "192x192",
			"type": "image/png"
		},
		{
			"src": "/assets/pwa/pwa-512x512.png",
			"sizes": "512x512",
			"type": "image/png"
		},
		{
			"src": "/assets/pwa/maskable-icon-512x512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	]
}
